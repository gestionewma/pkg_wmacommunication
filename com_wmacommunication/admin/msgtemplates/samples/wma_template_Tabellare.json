{
    "title": "Tabellare",
    "body": "<table style=\"width:100%; max-width:600px; border-collapse:collapse; font-family: Arial, Helvetica, sans-serif;\">\n    <tr>\n        <td colspan=\"2\" style=\"padding-bottom: 15px;\">\n            <span style=\"font-size: 18px; color: #1e293b; font-weight: 700;\">Nuovo messaggio dal sito</span>\n        </td>\n    </tr>\n    <tr>\n        <td width=\"50%\" style=\"padding-bottom: 15px; vertical-align: top;\">\n            <span style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; display: block; margin-bottom: 3px;\">Nome</span>\n            <span style=\"font-size: 15px; color: #1e293b; font-weight: 600;\">{Nome}</span>\n        </td>\n        <td width=\"50%\" style=\"padding-bottom: 15px; vertical-align: top;\">\n            <span style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; display: block; margin-bottom: 3px;\">Email</span>\n            <span style=\"font-size: 15px; color: #1e293b; font-weight: 600;\">{Email}</span>\n        </td>\n    </tr>\n    <tr>\n        <td width=\"50%\" style=\"padding-bottom: 15px; vertical-align: top;\">\n            <span style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; display: block; margin-bottom: 3px;\">Telefono</span>\n            <span style=\"font-size: 15px; color: #1e293b; font-weight: 600;\">{Telefono}</span>\n        </td>\n        <td width=\"50%\"></td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" style=\"padding-top: 10px; border-top: 1px solid #e2e8f0;\">\n            <span style=\"font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; display: block; margin-bottom: 3px;\">Messaggio</span>\n            <span style=\"font-size: 15px; color: #1e293b;\">{Messaggio}</span>\n        </td>\n    </tr>\n</table>"
}
